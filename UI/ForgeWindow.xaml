<Window x:Class="ParametricFamilyForge.UI.ForgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parametric Family Forge — Conversational AI Revit Family Copilot" 
        Height="860" Width="1220"
        MinHeight="700" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#14171D" Foreground="#E0E2E8"
        FontFamily="Segoe UI" FontSize="13"
        Loaded="ForgeWindow_Copilot_Loaded">

    <Window.Resources>
        <!-- UI Theme Colors -->
        <SolidColorBrush x:Key="PrimaryAccent" Color="#007ACC" />
        <SolidColorBrush x:Key="AccentHover" Color="#1C97EA" />
        <SolidColorBrush x:Key="PanelBackground" Color="#1D212A" />
        <SolidColorBrush x:Key="InputBackground" Color="#252A34" />
        <SolidColorBrush x:Key="BorderBrushColor" Color="#323846" />

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}" />
            <Setter Property="Foreground" Value="#E0E2E8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}" />
            <Setter Property="Foreground" Value="#E0E2E8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryAccent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHover}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#4B5263" />
                    <Setter Property="Foreground" Value="#828997" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TabControl Styling -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#181C24" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1D212A" />
            <Setter Property="Foreground" Value="#ABB2BF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="5,5,0,0" Margin="0,0,4,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#181C24" />
                                <Setter Property="Foreground" Value="#61AFEF" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#61AFEF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Copilot Header & Settings Bar -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,10" Background="{StaticResource PanelBackground}" BorderBrush="#2C3340" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#007ACC" CornerRadius="6" Padding="8,4" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="🤖 AI COPILOT" FontSize="11" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Parametric Family Forge — Conversational BIM Copilot" FontSize="17" FontWeight="Bold" Foreground="#61AFEF" />
                            <TextBlock Text="CREATE • INSPECT • MODIFY • REPAIR • VALIDATE Live Revit Families (Revit 2024 / 2025 / 2026)" FontSize="11.5" Foreground="#98C379" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="ChkAutoExecutePlan" Content="⚡ Auto-Execute Plans in Revit" IsChecked="True" Foreground="#98C379" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Automatically execute structured Copilot plans in Revit and run BRep validation immediately" />
                        <Button x:Name="BtnPreview3D" Content="👁️ 3D Web Orbit" ToolTip="Launch interactive Three.js 3D Web Viewer" Click="BtnPreview3D_Click" Background="#252A34" BorderBrush="#98C379" BorderThickness="1" Foreground="#98C379" Margin="0,0,8,0" Padding="10,5" FontSize="11.5" />
                        <Button x:Name="BtnToggleSettings" Content="⚙ Gemini API &amp; Paths" Background="#323846" Click="BtnToggleSettings_Click" Padding="10,5" FontSize="11.5" />
                    </StackPanel>
                </Grid>

                <!-- Collapsible Settings Panel -->
                <Border x:Name="SettingsPanel" Grid.Row="1" Margin="0,10,0,0" Padding="12" Background="#14171D" BorderBrush="#323846" BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- API Key -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Gemini API Key (Leave blank for deterministic offline Copilot):" FontSize="11" Foreground="#ABB2BF" Margin="0,0,0,3" />
                                <PasswordBox x:Name="TxtApiKey" Background="{StaticResource InputBackground}" Foreground="White" BorderBrush="{StaticResource BorderBrushColor}" Padding="5" />
                            </StackPanel>

                            <!-- Model Engine Selector -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="AI Model Engine:" FontSize="11" Foreground="#ABB2BF" Margin="0,0,0,3" />
                                <ComboBox x:Name="CmbModelEngine" IsEditable="True" SelectedIndex="0">
                                    <ComboBoxItem Content="gemini-3.8-flash (Recommended - Gemini 3.8 Flash)" Tag="gemini-3.8-flash" />
                                    <ComboBoxItem Content="gemini-4-argon (Gemini 4 Argon - Frontier Reasoning)" Tag="gemini-4-argon" />
                                    <ComboBoxItem Content="gemini-3.1-flash-lite (Gemini 3.1 Flash-Lite - Fast)" Tag="gemini-3.1-flash-lite" />
                                    <ComboBoxItem Content="gemini-3-pro-preview (Gemini 3 Pro Multimodal)" Tag="gemini-3-pro-preview" />
                                    <ComboBoxItem Content="gemini-3-flash-preview (Gemini 3 Flash Preview)" Tag="gemini-3-flash-preview" />
                                    <ComboBoxItem Content="gemini-3.6-flash (Gemini 3.6 Flash)" Tag="gemini-3.6-flash" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Temperature -->
                            <StackPanel Grid.Column="4">
                                <Grid>
                                    <TextBlock Text="Temperature:" FontSize="11" Foreground="#ABB2BF" Margin="0,0,0,3" />
                                    <TextBlock x:Name="TxtTempValue" Text="0.2" FontSize="11" Foreground="#61AFEF" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="SliderTemperature" Minimum="0.0" Maximum="1.0" Value="0.2" TickFrequency="0.05" IsSnapToTickEnabled="True" 
                                        ValueChanged="SliderTemperature_ValueChanged" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Save Settings Button -->
                            <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                                <Button x:Name="BtnSaveSettings" Content="Save Config" Background="#98C379" Foreground="#1E2227" Click="BtnSaveSettings_Click" Padding="14,5" />
                            </StackPanel>
                        </Grid>

                        <!-- Template & Output Directories inside Settings Drawer -->
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Revit Family Template Directory (.rft):" FontSize="11" Foreground="#ABB2BF" />
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtTemplateDir" />
                                    <Button Grid.Column="1" Content="..." Margin="6,0,0,0" Click="BtnBrowseTemplateDir_Click" Background="#3E4451" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Output Family Destination (.rfa):" FontSize="11" Foreground="#ABB2BF" />
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtOutputDir" />
                                    <Button Grid.Column="1" Content="..." Margin="6,0,0,0" Click="BtnBrowseOutputDir_Click" Background="#3E4451" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Body Grid: Left = Live Revit Family Inspector & Context | Right = Conversational AI Copilot -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="310" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="540" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: LIVE REVIT FAMILY STATE INSPECTOR & CUT-SHEET ATTACHMENT -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Active Family Header Card -->
                <Border Grid.Row="0" Background="{StaticResource PanelBackground}" BorderBrush="#323846" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🏛️ LIVE REVIT SOURCE OF TRUTH" FontWeight="Bold" FontSize="11" Foreground="#61AFEF" VerticalAlignment="Center" />
                            <Button x:Name="BtnInspectLive" Grid.Column="1" Content="🔄 Inspect Now" Click="BtnInspectLive_Click" Background="#2C3340" Padding="8,3" FontSize="11" />
                        </Grid>
                        <TextBlock x:Name="TxtLiveDocName" Text="Active Revit Family" FontSize="15" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TxtLiveDocParams" Text="Category: Windows | 0 params | 0 solids" FontSize="11.5" Foreground="#98C379" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Live Parameters & Geometry Tree / Lists -->
                <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="#323846" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1.1*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="0.9*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="📏 Live Family Parameters (Click to Modify in Chat)" FontWeight="SemiBold" Foreground="#E5C07B" FontSize="11.5" Margin="0,0,0,6" />
                        <Border Grid.Row="1" Background="#14171D" BorderBrush="#282C34" BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,0,0,10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="LstLiveParameters">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1D212A" CornerRadius="3" Padding="6,4" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonUp="LiveParamItem_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#E0E2E8" FontSize="11.5" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayValue}" Foreground="#98C379" FontFamily="Consolas" FontSize="11" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Grid.Row="2" Text="🧱 Live 3D BRep Solids &amp; Reference Planes" FontWeight="SemiBold" Foreground="#61AFEF" FontSize="11.5" Margin="0,0,0,6" />
                        <Border Grid.Row="3" Background="#14171D" BorderBrush="#282C34" BorderThickness="1" CornerRadius="4" Padding="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="LstLiveSolids">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1D212A" CornerRadius="3" Padding="6,4" Margin="0,0,0,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Foreground="#ABB2BF" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding SizeSummary}" Foreground="#56B6C2" FontFamily="Consolas" FontSize="10.5" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <!-- Reference Cut-Sheet / Multimodal Context Attachment -->
                <Border Grid.Row="2" Background="{StaticResource PanelBackground}" BorderBrush="#323846" BorderThickness="1" Padding="10" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="📎 Attach Cut-Sheet / Sketch for Copilot Vision" FontWeight="SemiBold" Foreground="#C678DD" FontSize="11.5" Margin="0,0,0,6" />
                        <Border x:Name="DropZone" Height="82" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1.5" 
                                CornerRadius="4" AllowDrop="True" Background="#14171D"
                                Drop="DropZone_Drop" DragOver="DropZone_DragOver">
                            <Grid>
                                <StackPanel x:Name="EmptyDropContent" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Drop PDF Cut-Sheet / CAD Sketch Here" FontSize="11" HorizontalAlignment="Center" Foreground="#ABB2BF" />
                                    <Button Content="Browse Image / PDF" Margin="0,5,0,0" Padding="8,3" FontSize="11" Click="BtnBrowseImage_Click" Background="#323846" />
                                </StackPanel>
                                <Image x:Name="ImgPreview" Stretch="Uniform" Margin="4" Visibility="Collapsed" />
                                <Border x:Name="PdfBadge" Background="#E06C75" CornerRadius="4" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="📄 PDF Cut-Sheet Attached" Foreground="White" FontWeight="Bold" FontSize="11.5" />
                                </Border>
                                <Button x:Name="BtnClearImage" Content="✕" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" 
                                        Margin="4" Background="#E06C75" Visibility="Collapsed" Click="BtnClearImage_Click" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="TxtImageStatus" Text="Optional: attach PDF/PNG/JPG for multimodal Copilot" FontSize="10.5" Foreground="#5C6370" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#282C34" />

            <!-- RIGHT MAIN WORKSPACE: CONVERSATIONAL COPILOT, 2D PREVIEW & LEGACY STUDIO -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="110" />
                </Grid.RowDefinitions>

                <!-- Live AI Active Reasoning Status Banner -->
                <Border x:Name="AiStatusBanner" Grid.Row="0" Background="#1B2B24" BorderBrush="#98C379" BorderThickness="1" CornerRadius="5" Padding="10,7" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🧠 Copilot Reasoning &amp; Executing Revit Operations..." FontWeight="Bold" Foreground="#98C379" FontSize="12" />
                            <TextBlock x:Name="TxtAiElapsed" Grid.Column="1" Text="0s" FontWeight="SemiBold" Foreground="#E5C07B" FontFamily="Consolas" FontSize="12" />
                        </Grid>
                        <ProgressBar x:Name="AiModelProgBar" Height="6" IsIndeterminate="True" Foreground="#98C379" Background="#282C34" BorderThickness="0" Margin="0,0,0,4" />
                        <TextBlock x:Name="TxtAiStatus" Text="Inspecting live Revit Family state..." Foreground="#ABB2BF" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Main Workspace Tabs -->
                <TabControl x:Name="RightTabControl" Grid.Row="1" Background="#181C24" BorderBrush="{StaticResource BorderBrushColor}" SelectionChanged="RightTabControl_SelectionChanged">

                    <!-- TAB 0: CONVERSATIONAL AI REVIT FAMILY COPILOT (DEFAULT PRIMARY VIEW) -->
                    <TabItem Header="💬 Conversational AI Copilot" IsSelected="True">
                        <Grid Background="#181C24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Quick Action Prompt Chips Bar -->
                            <Border Grid.Row="0" Background="#1D212A" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,0,1" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="⚡ Interactive Copilot Prompts (Click any step to test conversational CREATE → MODIFY → ADD → FLEX):" FontSize="11" FontWeight="SemiBold" Foreground="#ABB2BF" Margin="0,0,0,6" />
                                    <WrapPanel>
                                        <Button Content="1️⃣ Create 1200×1500 Window (75mm frame)" Click="QuickChip_Click" Tag="Create a 1200 x 1500 parametric window with a 75 mm frame." Background="#252A34" Foreground="#98C379" FontSize="11" Padding="9,4" Margin="0,0,6,4" />
                                        <Button Content="2️⃣ Make the frame 100 mm" Click="QuickChip_Click" Tag="Make the frame 100 mm." Background="#252A34" Foreground="#E5C07B" FontSize="11" Padding="9,4" Margin="0,0,6,4" />
                                        <Button Content="3️⃣ Change width to 1500 mm" Click="QuickChip_Click" Tag="Change width to 1500 mm." Background="#252A34" Foreground="#56B6C2" FontSize="11" Padding="9,4" Margin="0,0,6,4" />
                                        <Button Content="4️⃣ Add a 75 mm projecting sill" Click="QuickChip_Click" Tag="Add a 75 mm projecting sill." Background="#252A34" Foreground="#61AFEF" FontSize="11" Padding="9,4" Margin="0,0,6,4" />
                                        <Button Content="5️⃣ Why isn't width flexing?" Click="QuickChip_Click" Tag="Why isn't the width parameter flexing correctly?" Background="#252A34" Foreground="#E06C75" FontSize="11" Padding="9,4" Margin="0,0,6,4" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Scrollable Chat Stream + Plan & Validation Cards -->
                            <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12">
                                <StackPanel x:Name="ChatStackPanel">
                                    <!-- Welcome Card -->
                                    <Border Background="#1D212A" BorderBrush="#2C3340" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="🤖 Welcome to the Conversational Revit Family Copilot" FontWeight="Bold" Foreground="#61AFEF" FontSize="13.5" Margin="0,0,0,4" />
                                            <TextBlock Text="Unlike one-shot generators, I inspect your currently open Revit Family Document before every turn, plan atomic BIM operations (CREATE_PARAMETER, CREATE_REFERENCE_PLANE, CREATE_EXTRUSION, SET_PARAMETER, ALIGN, FLEX_PARAMETER), execute them deterministically, and verify the resulting 3D BRep geometry." Foreground="#ABB2BF" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Plan Card Container -->
                                    <Border x:Name="PlanCard" Background="#1B222C" BorderBrush="#61AFEF" BorderThickness="1.5" CornerRadius="6" Padding="12" Margin="0,0,0,10" Visibility="Collapsed">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="TxtPlanTitle" Text="📋 Structured Copilot Execution Plan" FontWeight="Bold" Foreground="#61AFEF" FontSize="13" />
                                                <Border x:Name="BadgePlanIntent" Grid.Column="1" Background="#282C34" CornerRadius="3" Padding="6,2">
                                                    <TextBlock x:Name="TxtPlanIntent" Text="CREATE_GEOMETRY" FontSize="10" FontWeight="Bold" Foreground="#98C379" />
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="TxtPlanSummary" Text="Plan summary description" Foreground="#E0E2E8" FontSize="12" Margin="0,0,0,8" />
                                            <TextBlock Text="Atomic Revit API Operations:" FontWeight="SemiBold" Foreground="#ABB2BF" FontSize="11" Margin="0,0,0,4" />
                                            <ItemsControl x:Name="LstPlanOperations" Margin="0,0,0,8">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#21252B" CornerRadius="3" Padding="6,3" Margin="0,0,0,3">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Background="#282C34" CornerRadius="2" Padding="5,1" Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding Operation}" FontSize="10" FontWeight="Bold" Foreground="#61AFEF" FontFamily="Consolas" />
                                                                </Border>
                                                                <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="11" Foreground="#ABB2BF" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button x:Name="BtnExecuteCopilotPlan" Content="⚡ Execute Plan in Active Revit Family" Click="BtnExecuteCopilotPlan_Click" Background="#98C379" Foreground="#1E2227" FontWeight="Bold" Height="34" FontSize="12.5" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Post-Execution Validation Result Card Container -->
                                    <Border x:Name="ValidationCard" Background="#1B2B24" BorderBrush="#98C379" BorderThickness="1.5" CornerRadius="6" Padding="12" Margin="0,0,0,10" Visibility="Collapsed">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="TxtValHeader" Text="🛡️ Post-Execution BRep &amp; Intent Verification" FontWeight="Bold" Foreground="#98C379" FontSize="13" />
                                                <Border x:Name="BadgeValStatus" Grid.Column="1" Background="#282C34" CornerRadius="3" Padding="6,2">
                                                    <TextBlock x:Name="TxtValBadge" Text="INTENT VERIFIED" FontSize="10" FontWeight="Bold" Foreground="#98C379" />
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="TxtValSummary" Text="Validation summary" Foreground="#E0E2E8" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap" />
                                            <TextBlock x:Name="TxtValComponents" Text="Components: 5 distinct solids verified in Revit BRep" Foreground="#ABB2BF" FontSize="11" Margin="0,0,0,4" />
                                            <TextBlock x:Name="TxtValFlex" Text="Flex Test: Width +200mm physically resized geometry" Foreground="#98C379" FontSize="11" Margin="0,0,0,4" />
                                            <ItemsControl x:Name="LstDiscrepancies" Margin="0,4,0,6">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Foreground="#E06C75" FontSize="11" Margin="0,1" TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button x:Name="BtnAutoRepair" Content="🔧 Execute Auto-Repair Plan" Click="BtnAutoRepair_Click" Background="#E5C07B" Foreground="#1E2227" FontWeight="Bold" Height="30" FontSize="11.5" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Bottom Conversational Input Bar -->
                            <Border Grid.Row="2" Background="#1D212A" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,1,0,0" Padding="10,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtCopilotInput" Height="38" FontSize="13" Padding="10,6" VerticalContentAlignment="Center"
                                             ToolTip="Ask Copilot to create, modify, inspect, add components, or flex-test the current family..."
                                             KeyDown="TxtCopilotInput_KeyDown" Background="#14171D" Foreground="White" BorderBrush="#3E4451" />
                                    <Button x:Name="BtnSendCopilot" Grid.Column="1" Content="💬 Send to Copilot ↵" Margin="8,0,0,0" Padding="18,0" Height="38"
                                            Background="#007ACC" Foreground="White" FontWeight="Bold" FontSize="12.5" Click="BtnSendCopilot_Click" />
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 1: INTERACTIVE 2D GEOMETRY PREVIEW -->
                    <TabItem Header="📐 2D Plan &amp; Elevation Preview">
                        <Grid Background="#1E2227">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Preview Controls Bar -->
                            <Border Grid.Row="0" Background="#21252B" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,0,1" Padding="8,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="TxtPreviewDimensions" Text="Dimensions: 1600 × 800 × 750 mm | 2 Extrusions" Foreground="#ABB2BF" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="View:" Foreground="#5C6370" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <ComboBox x:Name="CmbPreviewLayout" SelectionChanged="CmbPreviewLayout_SelectionChanged" FontSize="11" Padding="4,2" Margin="0,0,6,0">
                                            <ComboBoxItem Content="Side-by-Side (Plan | Elevation)" IsSelected="True" Tag="both" />
                                            <ComboBoxItem Content="Plan View (Top-Down X-Y)" Tag="plan" />
                                            <ComboBoxItem Content="Front Elevation (X-Z)" Tag="elevation" />
                                        </ComboBox>
                                        <Button x:Name="BtnRefreshPreview" Content="🔄 Redraw" ToolTip="Redraw 2D geometry views" Click="BtnRefreshPreview_Click" Background="#3E4451" Padding="6,2" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Viewports Grid -->
                            <Grid Grid.Row="1" Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ColPlan" Width="*" />
                                    <ColumnDefinition x:Name="ColSplitter" Width="6" />
                                    <ColumnDefinition x:Name="ColElevation" Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Plan View Viewport -->
                                <Border x:Name="BorderPlan" Grid.Column="0" Background="#14171C" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                                    <Canvas x:Name="CanvasPlan" ClipToBounds="True" SizeChanged="Canvas_SizeChanged" />
                                </Border>

                                <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#282C34" />

                                <!-- Front Elevation Viewport -->
                                <Border x:Name="BorderElevation" Grid.Column="2" Background="#14171C" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                                    <Canvas x:Name="CanvasElevation" ClipToBounds="True" SizeChanged="Canvas_SizeChanged" />
                                </Border>
                            </Grid>

                            <!-- Bottom Legend -->
                            <Border Grid.Row="2" Background="#1E2227" Padding="8,4" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,1,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Rectangle Width="9" Height="9" Fill="#61AFEF" Margin="0,0,3,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Solid" FontSize="9.5" Foreground="#ABB2BF" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <Rectangle Width="9" Height="9" Fill="#56B6C2" Margin="0,0,3,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Blend / Taper" FontSize="9.5" Foreground="#ABB2BF" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <Border Width="9" Height="9" BorderBrush="#E06C75" BorderThickness="1.2" Background="#25E06C75" Margin="0,0,3,0" VerticalAlignment="Center" />
                                    <TextBlock Text="✂️ Void Cut" FontSize="9.5" Foreground="#E06C75" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <Rectangle Width="9" Height="9" Fill="#98C379" Margin="0,0,3,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Nested" FontSize="9.5" Foreground="#ABB2BF" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <Ellipse Width="8" Height="8" Fill="#E5C07B" Stroke="#D19A66" StrokeThickness="1" Margin="0,0,3,0" VerticalAlignment="Center" />
                                    <TextBlock Text="MEP" FontSize="9.5" Foreground="#ABB2BF" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <Rectangle Width="8" Height="2" Fill="#E5C07B" Margin="0,0,3,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Dim" FontSize="9.5" Foreground="#ABB2BF" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <Rectangle Width="8" Height="2" Fill="#415A77" Margin="0,0,3,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Ref Plane" FontSize="9.5" Foreground="#ABB2BF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2: ONE-SHOT SCHEMA STUDIO & PRESETS (LEGACY / ADVANCED BATCH MODE) -->
                    <TabItem Header="🛠️ One-Shot JSON Schema Studio">
                        <Grid Background="#181C24" Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Top Prompt + Presets + Export Toolbar -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="One-Shot Family Prompt:" FontSize="11" Foreground="#98C379" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox x:Name="TxtPrompt" Height="54" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                             Text="Modern ergonomic office workstation: 1600mm width, 800mm depth, 750mm height, with 4 nested metallic cylindrical legs and parametric linked dimensions." />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnSynthesizeAi" Grid.Column="0" Content="Synthesize AI (Gemini)" Click="BtnSynthesizeAi_Click" Background="#98C379" Foreground="#1E2227" Padding="8,4" FontSize="11.5" />
                                        <Button x:Name="BtnDeterministic" Grid.Column="2" Content="Deterministic Fallback" Click="BtnDeterministic_Click" Background="#61AFEF" Foreground="#1E2227" Padding="8,4" FontSize="11.5" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Architectural Preset &amp; Export Tools:" FontSize="11" Foreground="#61AFEF" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox x:Name="CmbPresets" SelectionChanged="CmbPresets_SelectionChanged" FontSize="11" Padding="6,4" Margin="0,0,0,6">
                                        <ComboBoxItem Content="-- Choose Built-In Architectural Preset --" Tag="" IsSelected="True" />
                                        <ComboBoxItem Content="🪑 Ergonomic Workstation (Desk, Modesty Panel, 4 Nested Legs, 4 Sizes)" Tag="workstation" />
                                        <ComboBoxItem Content="🚪 Commercial Flush Door (Leaf, Frame, Vision Lite, Lever Hardware)" Tag="commercial_door" />
                                        <ComboBoxItem Content="🗄️ Casework Base Cabinet (Box, Countertop, Toe Kick, Nested Pull)" Tag="casework_cabinet" />
                                        <ComboBoxItem Content="🏛️ Architectural Column (Plinth Base, Tuscan Shaft, Capital)" Tag="column" />
                                        <ComboBoxItem Content="👥 Executive Conference Table (Top Slab, Twin Pedestals, 3 Sizes)" Tag="conference_table" />
                                    </ComboBox>
                                    <WrapPanel>
                                        <Button x:Name="BtnImportJson" Content="📂 Import" Click="BtnImportJson_Click" Background="#3E4451" Margin="0,0,4,4" Padding="8,4" FontSize="11" />
                                        <Button x:Name="BtnExportJson" Content="💾 Save JSON" Click="BtnExportJson_Click" Background="#3E4451" Margin="0,0,4,4" Padding="8,4" FontSize="11" />
                                        <Button x:Name="BtnExportCsv" Content="📊 CSV Catalog" Click="BtnExportCsv_Click" Background="#3E4451" Margin="0,0,4,4" Padding="8,4" FontSize="11" />
                                        <Button x:Name="BtnExportSharedParams" Content="🏷️ Shared Params" Click="BtnExportSharedParams_Click" Background="#3E4451" Margin="0,0,4,4" Padding="8,4" FontSize="11" />
                                        <Button x:Name="BtnValidate" Content="✔️ Validate" Click="BtnValidate_Click" Background="#2C313A" BorderBrush="#61AFEF" BorderThickness="1" Margin="0,0,0,4" Padding="8,4" FontSize="11" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Validation Banner -->
                            <Border x:Name="ValidationBanner" Grid.Row="1" Background="#1B222C" BorderBrush="#61AFEF" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtValidationStatus" Text="✅ Ready: 8 Parameters, 2 Extrusions, 1 Nested Family, 4 Types" Foreground="#98C379" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="TxtValidationBadge" Grid.Column="1" Text="Pre-Validated" Foreground="#61AFEF" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </Grid>
                            </Border>

                            <!-- JSON Text Editor -->
                            <TextBox x:Name="TxtJsonPreview" Grid.Row="2" AcceptsReturn="True" TextWrapping="NoWrap"
                                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="12" Foreground="#98C379" Background="#14171D"
                                     BorderBrush="#2C3340" BorderThickness="1"
                                     TextChanged="TxtJsonPreview_TextChanged" />

                            <!-- Schema Refiner Bar -->
                            <Border Grid.Row="3" Background="#21252B" BorderBrush="#3E4451" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,6,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                                        <Button x:Name="BtnChipDeeper" Content="+25mm Depth" Click="BtnChip_Click" Tag="Increase the inner bowl void depth by 25mm" Background="#2C313A" Foreground="#ABB2BF" FontSize="10" Padding="5,2" Margin="0,0,4,0" />
                                        <Button x:Name="BtnChipOverflow" Content="+ Overflow" Click="BtnChip_Click" Tag="Add a circular void overflow hole" Background="#2C313A" Foreground="#ABB2BF" FontSize="10" Padding="5,2" Margin="0,0,4,0" />
                                        <Button x:Name="BtnChipWallHung" Content="Wall-Hung" Click="BtnChip_Click" Tag="Convert basin to wall-hung model" Background="#2C313A" Foreground="#ABB2BF" FontSize="10" Padding="5,2" Margin="0,0,4,0" />
                                        <Button x:Name="BtnChipTapSpout" Content="Tall Spout" Click="BtnChip_Click" Tag="Make tap spout 35mm taller" Background="#2C313A" Foreground="#ABB2BF" FontSize="10" Padding="5,2" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtRefinePrompt" Grid.Column="1" Height="28" FontSize="11" Padding="6,3" VerticalContentAlignment="Center"
                                             KeyDown="TxtRefinePrompt_KeyDown" Background="#1E2227" Foreground="#E5C07B" BorderBrush="#3E4451" />
                                    <Button x:Name="BtnRefineGeometry" Grid.Column="2" Content="✨ Refine JSON" Margin="6,0,0,0" Padding="10,0" Height="28" FontSize="11"
                                            Background="#61AFEF" Foreground="#1E2227" Click="BtnRefineGeometry_Click" />
                                </Grid>
                            </Border>

                            <!-- Generate One-Shot Button -->
                            <Button x:Name="BtnGenerateRevitFamily" Grid.Row="4" Content="🚀 Generate One-Shot Family from JSON Schema (.rfa)" 
                                    Height="36" FontSize="13" FontWeight="Bold" Click="BtnGenerateRevitFamily_Click" />
                        </Grid>
                    </TabItem>
                </TabControl>

                <!-- Row 2: Execution & Copilot Diagnostic Logs Console -->
                <Border Grid.Row="2" Margin="0,8,0,0" Background="#14171D" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="0" Margin="8,4,8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⚡ Live Revit API &amp; Copilot Execution Telemetry:" FontSize="11" FontWeight="SemiBold" Foreground="#61AFEF" VerticalAlignment="Center" />
                            <Button x:Name="BtnClearLogs" Grid.Column="1" Content="Clear" Background="Transparent" Foreground="#5C6370" FontSize="10" Padding="4,1" BorderThickness="0" Click="BtnClearLogs_Click" Cursor="Hand" />
                        </Grid>
                        
                        <TextBox x:Name="TxtLogs" Grid.Row="1" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                 Foreground="#ABB2BF" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" />
                        <ProgressBar x:Name="ProgBar" Grid.Row="2" Height="5" IsIndeterminate="True" Visibility="Collapsed" Foreground="#61AFEF" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <TextBlock Grid.Row="2" Text="Conversational AI Revit Family Copilot v3.0 | Live Family Inspection + Atomic Operation Executor + BRep Intent Validator | Revit 2024 / 2025 / 2026" FontSize="11" Foreground="#5C6370" Margin="0,8,0,0" />
    </Grid>
</Window>
