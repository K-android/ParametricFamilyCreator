<Page x:Class="ParametricFamilyForge.UI.ForgeDockablePanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="440"
      Title="AI Family Forge" Background="#1E2227" Foreground="#ABB2BF"
      FontFamily="Segoe UI" FontSize="12">

    <Page.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#21252B" />
        <SolidColorBrush x:Key="CardBg" Color="#282C34" />
        <SolidColorBrush x:Key="BorderColor" Color="#3E4451" />
        <SolidColorBrush x:Key="AccentBlue" Color="#61AFEF" />
        <SolidColorBrush x:Key="AccentGreen" Color="#98C379" />
        <SolidColorBrush x:Key="AccentAmber" Color="#E5C07B" />
        <SolidColorBrush x:Key="AccentRed" Color="#E06C75" />
        <SolidColorBrush x:Key="AccentTeal" Color="#56B6C2" />
        <SolidColorBrush x:Key="AccentPurple" Color="#C678DD" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3E4451" />
            <Setter Property="Foreground" Value="#DCDFE4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E2227" />
            <Setter Property="Foreground" Value="#DCDFE4" />
            <Setter Property="BorderBrush" Value="#3E4451" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- Row 0: App Header & Engine Selection -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Main Scrollable Workflow Content -->
            <RowDefinition Height="*" />
            <!-- Row 2: Live Engine Console Log -->
            <RowDefinition Height="130" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header & Engine Selection -->
        <Border Grid.Row="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡ AI Family Forge" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBlue}" />
                        <Border Background="#2C313A" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
                            <TextBlock Text="PRO BIM DOCK" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtActiveDocStatus" Text="End-to-End Procedural &amp; Revolve Engine" FontSize="10" Foreground="#5C6370" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Model Engine & Settings Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="CmbDockModel" Width="135" FontSize="11" Margin="0,0,6,0">
                        <ComboBoxItem Content="gemini-3.8-flash" IsSelected="True" Tag="gemini-3.8-flash" />
                        <ComboBoxItem Content="gemini-4-argon" Tag="gemini-4-argon" />
                        <ComboBoxItem Content="gemini-3.1-flash-lite" Tag="gemini-3.1-flash-lite" />
                        <ComboBoxItem Content="Offline AEC Rules" Tag="offline" />
                    </ComboBox>
                    <Button x:Name="BtnToggleSettings" Content="⚙️" ToolTip="Configure API Key and Settings" Width="28" Height="26" Padding="0" Click="BtnToggleSettings_Click" Background="#2C313A" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Settings Popup Panel (Collapsible) -->
        <Border x:Name="BorderSettings" Grid.Row="0" Background="#1E2227" BorderBrush="{StaticResource AccentAmber}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8" Panel.ZIndex="100" Visibility="Collapsed">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="⚙️ Configuration &amp; Credentials" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" />
                    <Button Content="✕" HorizontalAlignment="Right" Width="20" Height="20" Padding="0" Click="BtnCloseSettings_Click" Background="Transparent" Foreground="#ABB2BF" />
                </Grid>
                <TextBlock Text="Google Gemini API Key:" FontSize="10" Foreground="#ABB2BF" Margin="0,0,0,2" />
                <PasswordBox x:Name="TxtDockApiKey" PasswordChar="●" Background="#282C34" Foreground="#98C379" BorderBrush="{StaticResource BorderColor}" Padding="6,3" Margin="0,0,0,6" />
                <Button Content="Save Credentials" Click="BtnSaveSettings_Click" Background="{StaticResource AccentGreen}" Foreground="#1E2227" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Row 1: Main Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
            <StackPanel>
                <!-- 1. Architectural Intake Card -->
                <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="1. Architectural Specification &amp; Cut-Sheet" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,6" />

                        <!-- Archetype Rig Selection -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="BIM Category / Rig:" FontSize="11" Foreground="#ABB2BF" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="CmbArchetype" Grid.Column="1" FontSize="11">
                                <ComboBoxItem Content="Auto-Detect from Cut-Sheet (Any Category)" IsSelected="True" Tag="auto" />
                                <ComboBoxItem Content="Plumbing: Wall-Hung Pedestal Basin" Tag="pedestal" />
                                <ComboBoxItem Content="Plumbing: Vessel Basin (Revolved Cavity)" Tag="vessel" />
                                <ComboBoxItem Content="Plumbing: Undermount Vanity Sink" Tag="undermount" />
                                <ComboBoxItem Content="Plumbing: Kitchen Double-Bowl Sink" Tag="kitchen" />
                                <ComboBoxItem Content="Plumbing: Commercial ADA Basin" Tag="ada" />
                                <ComboBoxItem Content="Doors: Single / Glazed Panel &amp; Wall Opening" Tag="door" />
                                <ComboBoxItem Content="Windows: Casement / Glazed Sash &amp; Opening" Tag="window" />
                                <ComboBoxItem Content="Furniture: Office Desk / Table / Workstation" Tag="desk" />
                                <ComboBoxItem Content="Furniture: Seating &amp; Task Chair" Tag="chair" />
                                <ComboBoxItem Content="Casework: Base Cabinets, Cupboards &amp; Shelving" Tag="casework" />
                                <ComboBoxItem Content="Mechanical &amp; MEP: Pumps, Chillers &amp; Equipment" Tag="mep" />
                                <ComboBoxItem Content="Structural: Column Baseplate &amp; Anchor Bolts" Tag="structural" />
                                <ComboBoxItem Content="Specialty Equipment / Generic Model" Tag="generic" />
                            </ComboBox>
                        </Grid>

                        <!-- Cut-Sheet Drag & Drop Zone -->
                        <Border x:Name="DockDropZone" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.5" CornerRadius="4" Padding="8" Margin="0,0,0,6" AllowDrop="True" Drop="DockDropZone_Drop" DragOver="DockDropZone_DragOver">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="📄 Drag &amp; Drop Cut-Sheet PDF or Image" FontWeight="SemiBold" FontSize="10.5" Foreground="#DCDFE4" />
                                    <TextBlock Text="Auto-extracts Plan, Elevation &amp; Section specs" FontSize="9.5" Foreground="#5C6370" Margin="0,1,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Browse..." Click="BtnBrowseFile_Click" Background="#3E4451" FontSize="10.5" Padding="8,3" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Attached File Badge -->
                        <Border x:Name="PdfFileBadge" Background="#2C313A" BorderBrush="{StaticResource AccentTeal}" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,0,6" Visibility="Collapsed">
                            <Grid>
                                <TextBlock x:Name="TxtPdfFileName" Text="📄 CutSheet.pdf" FontSize="10" Foreground="{StaticResource AccentTeal}" VerticalAlignment="Center" />
                                <Button Content="✕" HorizontalAlignment="Right" Width="16" Height="16" Padding="0" Click="BtnClearFile_Click" Background="Transparent" Foreground="#ABB2BF" />
                            </Grid>
                        </Border>

                        <!-- Design Prompt Textbox -->
                        <TextBlock Text="Design Prompt / Parametric Constraints:" FontSize="10.5" Foreground="#ABB2BF" Margin="0,0,0,3" />
                        <TextBox x:Name="TxtDockPrompt" Height="48" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 Text="Modern wash basin with half pedestal, 600mm width, 450mm depth, 850mm height, curved under-bowl transition, hollow inner bowl, faucet tap hole, chrome mixer tap, and waste drain." />

                        <!-- Big Primary Execution Button -->
                        <Button x:Name="BtnGenerateFamily" Click="BtnGenerateFamily_Click" Background="{StaticResource AccentBlue}" Foreground="#1E2227" FontSize="12" FontWeight="Bold" Margin="0,8,0,0" Padding="12,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="⚡ Generate High-LOD Parametric Family" FontSize="12" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 2. Live Geometry Pipeline Stepper Card -->
                <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="2. Procedural Geometry Pipeline" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}" />
                            <TextBlock x:Name="TxtPipelineStatus" Text="Ready" FontSize="10" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Stepper Progress Bar -->
                        <ProgressBar x:Name="DockProgBar" Height="5" Margin="0,0,0,8" IsIndeterminate="False" Value="0" Maximum="100" Foreground="{StaticResource AccentGreen}" Background="#282C34" />

                        <!-- 6 Pipeline Stages -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Stage 1 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="IconStage1" Text="○" Foreground="#5C6370" FontWeight="Bold" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="1. Specs &amp; Multi-View Orthographic Extraction" FontSize="10.5" Foreground="#ABB2BF" />
                            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="StatusStage1" Text="Pending" FontSize="10" Foreground="#5C6370" />

                            <!-- Stage 2 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="IconStage2" Text="○" Foreground="#5C6370" FontWeight="Bold" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="2. Reference Planes &amp; Parametric Constraints" FontSize="10.5" Foreground="#ABB2BF" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="StatusStage2" Text="Pending" FontSize="10" Foreground="#5C6370" Margin="0,2,0,0" />

                            <!-- Stage 3 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" x:Name="IconStage3" Text="○" Foreground="#5C6370" FontWeight="Bold" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="3. Primary Solids (Rim Deck, Pedestal &amp; Blends)" FontSize="10.5" Foreground="#ABB2BF" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="StatusStage3" Text="Pending" FontSize="10" Foreground="#5C6370" Margin="0,2,0,0" />

                            <!-- Stage 4 -->
                            <TextBlock Grid.Row="3" Grid.Column="0" x:Name="IconStage4" Text="○" Foreground="#5C6370" FontWeight="Bold" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="4. Boolean Cavities (Revolve Bowl Dish &amp; Voids)" FontSize="10.5" Foreground="#ABB2BF" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="2" x:Name="StatusStage4" Text="Pending" FontSize="10" Foreground="#5C6370" Margin="0,2,0,0" />

                            <!-- Stage 5 -->
                            <TextBlock Grid.Row="4" Grid.Column="0" x:Name="IconStage5" Text="○" Foreground="#5C6370" FontWeight="Bold" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="5. High Detail (Mixer Tap, Sweeps &amp; MEP Connectors)" FontSize="10.5" Foreground="#ABB2BF" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="4" Grid.Column="2" x:Name="StatusStage5" Text="Pending" FontSize="10" Foreground="#5C6370" Margin="0,2,0,0" />

                            <!-- Stage 6 -->
                            <TextBlock Grid.Row="5" Grid.Column="0" x:Name="IconStage6" Text="○" Foreground="#5C6370" FontWeight="Bold" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="6. Parametric Flex Rig &amp; PDF Rescan Audit" FontSize="10.5" Foreground="#ABB2BF" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="5" Grid.Column="2" x:Name="StatusStage6" Text="Pending" FontSize="10" Foreground="#5C6370" Margin="0,2,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. Revit Viewport Actions & Family Operations -->
                <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="3. Revit Viewport &amp; Project Operations" FontWeight="SemiBold" Foreground="{StaticResource AccentTeal}" Margin="0,0,0,6" />
                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <Button x:Name="BtnViewIn3D" Content="👁 View in 3D Editor" Click="BtnViewIn3D_Click" Background="#2C313A" Foreground="{StaticResource AccentTeal}" Margin="0,0,3,0" Padding="6,6" ToolTip="Opens and activates the 3D family document in Revit" />
                            <Button x:Name="BtnFlexTest" Content="⚡ Flex Test Types" Click="BtnFlexTest_Click" Background="#2C313A" Foreground="{StaticResource AccentAmber}" Margin="3,0,0,0" Padding="6,6" ToolTip="Stress-tests parametric formulas across all catalog types" />
                        </UniformGrid>
                        <UniformGrid Columns="2">
                            <Button x:Name="BtnSaveFamilyRfa" Content="💾 Save .rfa File" Click="BtnSaveFamilyRfa_Click" Background="#2C313A" Margin="0,0,3,0" Padding="6,6" />
                            <Button x:Name="BtnLoadActiveProject" Content="📥 Load into Project" Click="BtnLoadActiveProject_Click" Background="{StaticResource AccentGreen}" Foreground="#1E2227" Margin="3,0,0,0" Padding="6,6" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 4. Spec Rescan & Verification Audit -->
                <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="4. PDF Spec Verification Audit" FontWeight="SemiBold" Foreground="{StaticResource AccentAmber}" />
                                <Border Background="#2C313A" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
                                    <TextBlock x:Name="TxtMatchPercent" Text="95%" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" FontSize="10" />
                                </Border>
                            </StackPanel>
                            <Button Content="🔄 Rescan" Click="BtnRescanPdf_Click" Background="#2C313A" FontSize="9.5" Padding="6,1" HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock x:Name="TxtRescanStatus" Text="Automated dimensional cross-check against manufacturer specifications." FontSize="10" Foreground="#ABB2BF" Margin="0,0,0,6" TextWrapping="Wrap" />

                        <!-- Verification DataGrid -->
                        <DataGrid x:Name="GridVerification" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="130" Background="#1E2227" RowBackground="#282C34" AlternatingRowBackground="#21252B" BorderBrush="{StaticResource BorderColor}" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3E4451" FontSize="10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Feature" Binding="{Binding Feature}" Width="*" />
                                <DataGridTextColumn Header="Cut-Sheet Spec" Binding="{Binding SpecValue}" Width="90" />
                                <DataGridTextColumn Header="Modeled" Binding="{Binding ModeledValue}" Width="85" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="55" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- 5. Conversational Refinement Bar -->
                <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="5. Conversational Geometry Refiner" FontWeight="SemiBold" Foreground="{StaticResource AccentPurple}" Margin="0,0,0,4" />
                        <TextBlock Text="Request parametric modifications without re-prompting from scratch:" FontSize="9.5" Foreground="#5C6370" Margin="0,0,0,6" />

                        <!-- Quick Refine Chips -->
                        <WrapPanel Margin="0,0,0,6">
                            <Button Content="+25mm Bowl Depth" Tag="Make the inner bowl 25mm deeper" Click="BtnChip_Click" Background="#2C313A" FontSize="9.5" Margin="0,0,4,4" Padding="5,2" />
                            <Button Content="Add Overflow Hole" Tag="Add overflow hole cutout to basin" Click="BtnChip_Click" Background="#2C313A" FontSize="9.5" Margin="0,0,4,4" Padding="5,2" />
                            <Button Content="Wall-Hung Pedestal" Tag="Change pedestal to wall-hung half shroud" Click="BtnChip_Click" Background="#2C313A" FontSize="9.5" Margin="0,0,4,4" Padding="5,2" />
                            <Button Content="Tall Gooseneck Tap" Tag="Change mixer tap to tall gooseneck spout" Click="BtnChip_Click" Background="#2C313A" FontSize="9.5" Margin="0,0,4,4" Padding="5,2" />
                            <Button Content="Scale Width 800mm" Tag="Scale overall width to 800mm" Click="BtnChip_Click" Background="#2C313A" FontSize="9.5" Margin="0,0,4,4" Padding="5,2" />
                        </WrapPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtDockRefinePrompt" Height="26" FontSize="11" Margin="0,0,4,0" KeyDown="TxtDockRefinePrompt_KeyDown" />
                            <Button x:Name="BtnDockRefine" Grid.Column="1" Content="Refine ⚡" Click="BtnDockRefine_Click" Background="{StaticResource AccentPurple}" Foreground="#1E2227" FontSize="10.5" Padding="8,3" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Row 2: Live Engine Console Log -->
        <Border Grid.Row="2" Background="#14171C" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="⚡ Live Engine Console" FontSize="10" FontWeight="Bold" Foreground="#5C6370" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Clear" Click="BtnClearLog_Click" Background="Transparent" Foreground="#5C6370" FontSize="9" Padding="4,0" />
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" x:Name="ScrollLog" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="TxtDockLog" Background="Transparent" Foreground="#98C379" BorderThickness="0" FontFamily="Consolas" FontSize="9.5" IsReadOnly="True" TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>