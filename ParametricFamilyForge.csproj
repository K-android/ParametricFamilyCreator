<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Multi-target: net48 for Revit 2024, net8.0-windows for Revit 2025 and 2026 -->
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ParametricFamilyForge</RootNamespace>
    <AssemblyName>ParametricFamilyForge</AssemblyName>
  </PropertyGroup>

  <!-- Exclude installer sources from the add-in compilation -->
  <ItemGroup>
    <Compile Remove="Installer\**" />
    <None Include="Installer\**" />
  </ItemGroup>

  <!-- Revit API NuGet references (enables cloud & local builds without requiring local Revit installation) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2024.2.0" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.2.0" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.3.0" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.3.0" />
  </ItemGroup>

  <!-- Include Bundled Revit Family Templates -->
  <ItemGroup>
    <None Include="Templates\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Include Icons and Resources -->
  <ItemGroup>
    <Resource Include="Resources\*.png" />
    <None Include="Resources\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- System dependencies -->
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="PdfPig" Version="0.1.8" />
  </ItemGroup>

</Project>
