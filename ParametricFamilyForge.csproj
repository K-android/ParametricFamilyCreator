<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Multi-target: net48 for Revit 2024, net8.0-windows for Revit 2025 and 2026 -->
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ParametricFamilyForge</RootNamespace>
    <AssemblyName>ParametricFamilyForge</AssemblyName>
    
    <!-- Revit build paths by version -->
    <RevitVersion Condition="'$(RevitVersion)' == '' and '$(TargetFramework)' == 'net48'">2024</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and '$(TargetFramework)' == 'net8.0-windows'">2025</RevitVersion>
    <RevitInstallPath Condition="'$(RevitInstallPath)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitInstallPath>
  </PropertyGroup>

  <!-- Reference Revit API DLLs -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallPath)\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallPath)\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Nuget dependencies compatible across .NET 8 and .NET Framework 4.8 -->
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
  </ItemGroup>

  <!-- Post build event to copy .addin manifest to Revit Addins folder -->
  <Target Name="CopyAddinManifest" AfterTargets="Build" Condition="Exists('$(APPDATA)\Autodesk\Revit\Addins\$(RevitVersion)')">
    <Copy SourceFiles="$(ProjectDir)ParametricFamilyForge.addin" 
          DestinationFolder="$(APPDATA)\Autodesk\Revit\Addins\$(RevitVersion)" />
  </Target>

</Project>
