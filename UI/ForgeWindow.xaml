<Window x:Class="ParametricFamilyForge.UI.ForgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parametric Family Forge — AI &amp; Parametric Revit Modeler" 
        Height="840" Width="1160"
        MinHeight="680" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#181A1F" Foreground="#E0E2E8"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- UI Theme Colors -->
        <SolidColorBrush x:Key="PrimaryAccent" Color="#007ACC" />
        <SolidColorBrush x:Key="AccentHover" Color="#1C97EA" />
        <SolidColorBrush x:Key="PanelBackground" Color="#21252B" />
        <SolidColorBrush x:Key="InputBackground" Color="#282C34" />
        <SolidColorBrush x:Key="BorderBrushColor" Color="#3B4048" />

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}" />
            <Setter Property="Foreground" Value="#E0E2E8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}" />
            <Setter Property="Foreground" Value="#E0E2E8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryAccent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHover}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#4B5263" />
                    <Setter Property="Foreground" Value="#828997" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TabControl Styling -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#1E2227" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#21252B" />
            <Setter Property="Foreground" Value="#ABB2BF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Margin="0,0,2,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1E2227" />
                                <Setter Property="Foreground" Value="#61AFEF" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#61AFEF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Settings Bar -->
        <Border Grid.Row="0" Margin="0,0,0,14" Padding="12" Background="{StaticResource PanelBackground}" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Parametric Family Forge" FontSize="18" FontWeight="Bold" Foreground="#61AFEF" />
                        <TextBlock Text="Generative AI &amp; Procedural Revit Family Generator (Revit 2024 / 2025 / 2026 Compatible)" FontSize="12" Foreground="#ABB2BF" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnToggleSettings" Content="⚙ AI Engine Settings" Background="#3E4451" Click="BtnToggleSettings_Click" Margin="0,0,8,0" />
                    </StackPanel>
                </Grid>

                <!-- Collapsible Settings Panel -->
                <Border x:Name="SettingsPanel" Grid.Row="1" Margin="0,10,0,0" Padding="10" Background="#1E2227" CornerRadius="4" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- API Key -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Gemini API Key:" FontSize="11" Foreground="#ABB2BF" Margin="0,0,0,3" />
                            <PasswordBox x:Name="TxtApiKey" Background="{StaticResource InputBackground}" Foreground="White" BorderBrush="{StaticResource BorderBrushColor}" Padding="5" />
                        </StackPanel>

                        <!-- Model Engine Selector -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="AI Model Engine:" FontSize="11" Foreground="#ABB2BF" Margin="0,0,0,3" />
                            <ComboBox x:Name="CmbModelEngine" IsEditable="True" SelectedIndex="0">
                                <ComboBoxItem Content="gemini-3.8-flash (Recommended - Gemini 3.8 Flash)" Tag="gemini-3.8-flash" />
                                <ComboBoxItem Content="gemini-4-argon (Gemini 4 Argon - Frontier Reasoning)" Tag="gemini-4-argon" />
                                <ComboBoxItem Content="gemini-3.1-flash-lite (Gemini 3.1 Flash-Lite - Fast)" Tag="gemini-3.1-flash-lite" />
                                <ComboBoxItem Content="gemini-3-pro-preview (Gemini 3 Pro Multimodal)" Tag="gemini-3-pro-preview" />
                                <ComboBoxItem Content="gemini-3-flash-preview (Gemini 3 Flash Preview)" Tag="gemini-3-flash-preview" />
                                <ComboBoxItem Content="gemini-3.6-flash (Gemini 3.6 Flash)" Tag="gemini-3.6-flash" />
                            </ComboBox>
                        </StackPanel>

                        <!-- Temperature -->
                        <StackPanel Grid.Column="4">
                            <Grid>
                                <TextBlock Text="Temperature:" FontSize="11" Foreground="#ABB2BF" Margin="0,0,0,3" />
                                <TextBlock x:Name="TxtTempValue" Text="0.2" FontSize="11" Foreground="#61AFEF" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="SliderTemperature" Minimum="0.0" Maximum="1.0" Value="0.2" TickFrequency="0.05" IsSnapToTickEnabled="True" 
                                    ValueChanged="SliderTemperature_ValueChanged" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Save Settings Button -->
                        <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                            <Button x:Name="BtnSaveSettings" Content="Save Config" Background="#98C379" Foreground="#1E2227" Click="BtnSaveSettings_Click" Padding="12,5" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Body Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="360" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.2*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Prompt Box -->
                    <Border Background="{StaticResource PanelBackground}" Padding="12" CornerRadius="6" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="1. Design Prompt &amp; Dimensional Spec" FontWeight="SemiBold" Foreground="#98C379" Margin="0,0,0,6" />
                            <TextBox x:Name="TxtPrompt" Height="75" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     Text="Modern ergonomic office workstation: 1600mm width, 800mm depth, 750mm height, with 4 nested metallic cylindrical legs and parametric linked dimensions." />
                        </StackPanel>
                    </Border>

                    <!-- Image / PDF Cut-Sheet Upload -->
                    <Border Background="{StaticResource PanelBackground}" Padding="12" CornerRadius="6" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="2. Reference Cut-Sheet (PDF, CAD Print, or Sketch)" FontWeight="SemiBold" Foreground="#E5C07B" Margin="0,0,0,6" />
                            
                            <Border x:Name="DropZone" Height="110" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="2" 
                                    CornerRadius="4" AllowDrop="True" Background="#1E2227"
                                    Drop="DropZone_Drop" DragOver="DropZone_DragOver">
                                <Grid>
                                    <StackPanel x:Name="EmptyDropContent" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Drag &amp; Drop PDF Cut-Sheet or Image Here" HorizontalAlignment="Center" Foreground="#ABB2BF" />
                                        <Button Content="Browse Image / PDF File" Margin="0,8,0,0" Click="BtnBrowseImage_Click" Background="#3E4451" />
                                    </StackPanel>
                                    <Image x:Name="ImgPreview" Stretch="Uniform" Margin="4" Visibility="Collapsed" />
                                    <Border x:Name="PdfBadge" Background="#E06C75" CornerRadius="4" Padding="12,6" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="📄 PDF Cut-Sheet Attached" Foreground="White" FontWeight="Bold" FontSize="13" />
                                    </Border>
                                    <Button x:Name="BtnClearImage" Content="✕" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" 
                                            Margin="4" Background="#E06C75" Visibility="Collapsed" Click="BtnClearImage_Click" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="TxtImageStatus" Text="No file selected (Supports PDF, PNG, JPG, WEBP)" FontSize="11" Foreground="#5C6370" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Directories -->
                    <Border Background="{StaticResource PanelBackground}" Padding="12" CornerRadius="6" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="3. Environment Configuration" FontWeight="SemiBold" Foreground="#C678DD" Margin="0,0,0,6" />
                            
                            <TextBlock Text="Revit Family Template Directory (.rft):" FontSize="11" Foreground="#ABB2BF" />
                            <Grid Margin="0,2,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtTemplateDir" />
                                <Button Grid.Column="1" Content="..." Margin="6,0,0,0" Click="BtnBrowseTemplateDir_Click" Background="#3E4451" />
                            </Grid>

                            <TextBlock Text="Output Family Destination (.rfa):" FontSize="11" Foreground="#ABB2BF" />
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtOutputDir" />
                                <Button Grid.Column="1" Content="..." Margin="6,0,0,0" Click="BtnBrowseOutputDir_Click" Background="#3E4451" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Synthesize Buttons -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnSynthesizeAi" Grid.Column="0" Content="Synthesize AI (Gemini)" Click="BtnSynthesizeAi_Click" Background="#98C379" Foreground="#1E2227" />
                        <Button x:Name="BtnDeterministic" Grid.Column="2" Content="Deterministic Fallback" Click="BtnDeterministic_Click" Background="#61AFEF" Foreground="#1E2227" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#282C34" />

            <!-- Right Panel: JSON Schema Preview, Presets, Diagnostic & Execution -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="130" />
                </Grid.RowDefinitions>

                <!-- Row 0: Header & Presets Toolbar -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Revit Family Specification (JSON)" FontWeight="SemiBold" Foreground="#61AFEF" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnPreview3D" Content="👁️ 3D Web Orbit" ToolTip="Launch interactive Three.js 3D Web Viewer with Orbit Controls" Click="BtnPreview3D_Click" Background="#2C313A" BorderBrush="#98C379" BorderThickness="1" Foreground="#98C379" Margin="0,0,4,0" Padding="8,4" FontSize="11" />
                            <Button x:Name="BtnImportJson" Content="📂 Import" ToolTip="Import custom FamilySchema JSON from disk" Click="BtnImportJson_Click" Background="#3E4451" Margin="0,0,4,0" Padding="8,4" FontSize="11" />
                            <Button x:Name="BtnExportJson" Content="💾 Save" ToolTip="Save current FamilySchema JSON to disk" Click="BtnExportJson_Click" Background="#3E4451" Margin="0,0,4,0" Padding="8,4" FontSize="11" />
                            <Button x:Name="BtnExportCsv" Content="📊 CSV Catalog" ToolTip="Export Revit Type Catalog schedule (.csv/.txt)" Click="BtnExportCsv_Click" Background="#3E4451" Margin="0,0,4,0" Padding="8,4" FontSize="11" />
                            <Button x:Name="BtnExportSharedParams" Content="🏷️ Shared Params" ToolTip="Export Autodesk Revit Shared Parameter definition file (.txt)" Click="BtnExportSharedParams_Click" Background="#3E4451" Margin="0,0,4,0" Padding="8,4" FontSize="11" />
                            <Button x:Name="BtnValidate" Content="✔️ Validate" ToolTip="Validate schema integrity &amp; geometry" Click="BtnValidate_Click" Background="#2C313A" BorderBrush="#61AFEF" BorderThickness="1" Padding="8,4" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Preset Library:" FontSize="11" Foreground="#ABB2BF" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="CmbPresets" Grid.Column="1" SelectionChanged="CmbPresets_SelectionChanged" FontSize="11" Padding="6,3">
                            <ComboBoxItem Content="-- Choose Built-In Architectural Preset --" Tag="" IsSelected="True" />
                            <ComboBoxItem Content="🪑 Ergonomic Workstation (Desk, Modesty Panel, 4 Nested Legs, 4 Sizes)" Tag="workstation" />
                            <ComboBoxItem Content="🚪 Commercial Flush Door (Leaf, Frame, Vision Lite, Lever Hardware)" Tag="commercial_door" />
                            <ComboBoxItem Content="🗄️ Casework Base Cabinet (Box, Countertop, Toe Kick, Nested Pull)" Tag="casework_cabinet" />
                            <ComboBoxItem Content="🏛️ Architectural Column (Plinth Base, Tuscan Shaft, Capital)" Tag="column" />
                            <ComboBoxItem Content="👥 Executive Conference Table (Top Slab, Twin Pedestals, 3 Sizes)" Tag="conference_table" />
                        </ComboBox>
                    </Grid>
                </Grid>

                <!-- Row 1: Live AI Active Reasoning & Modelling Status Banner -->
                <Border x:Name="AiStatusBanner" Grid.Row="1" Background="#1B2B24" BorderBrush="#98C379" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🧠 AI Active Reasoning &amp; 3D BIM Modelling..." FontWeight="Bold" Foreground="#98C379" FontSize="12" />
                            <TextBlock x:Name="TxtAiElapsed" Grid.Column="1" Text="0s" FontWeight="SemiBold" Foreground="#E5C07B" FontFamily="Consolas" FontSize="12" />
                        </Grid>
                        <ProgressBar x:Name="AiModelProgBar" Height="8" IsIndeterminate="True" Foreground="#98C379" Background="#282C34" BorderThickness="0" Margin="0,0,0,5" />
                        <TextBlock x:Name="TxtAiStatus" Text="Initializing Gemini Vision multimodal analysis..." Foreground="#ABB2BF" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Row 2: Schema Diagnostic & Validation Banner -->
                <Border x:Name="ValidationBanner" Grid.Row="2" Background="#1B222C" BorderBrush="#61AFEF" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtValidationStatus" Text="✅ Ready: 8 Parameters, 2 Extrusions, 1 Nested Family, 4 Types" Foreground="#98C379" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TxtValidationBadge" Grid.Column="1" Text="Pre-Validated" Foreground="#61AFEF" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </Grid>
                </Border>

                <!-- Row 3: Tabs for Interactive 2D Geometry Preview & JSON Specification Editor -->
                <TabControl x:Name="RightTabControl" Grid.Row="3" Background="#1E2227" BorderBrush="{StaticResource BorderBrushColor}" SelectionChanged="RightTabControl_SelectionChanged">
                    <!-- Tab 1: Interactive 2D Geometry Preview -->
                    <TabItem Header="📐 Geometry Preview">
                        <Grid Background="#1E2227">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Preview Controls Bar -->
                            <Border Grid.Row="0" Background="#21252B" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,0,1" Padding="8,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="TxtPreviewDimensions" Text="Dimensions: 1600 × 800 × 750 mm | 2 Extrusions" Foreground="#ABB2BF" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="View:" Foreground="#5C6370" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <ComboBox x:Name="CmbPreviewLayout" SelectionChanged="CmbPreviewLayout_SelectionChanged" FontSize="11" Padding="4,2" Margin="0,0,6,0">
                                            <ComboBoxItem Content="Side-by-Side (Plan | Elevation)" IsSelected="True" Tag="both" />
                                            <ComboBoxItem Content="Plan View (Top-Down X-Y)" Tag="plan" />
                                            <ComboBoxItem Content="Front Elevation (X-Z)" Tag="elevation" />
                                        </ComboBox>
                                        <Button x:Name="BtnRefreshPreview" Content="🔄 Redraw" ToolTip="Redraw 2D geometry views" Click="BtnRefreshPreview_Click" Background="#3E4451" Padding="6,2" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Viewports Grid -->
                            <Grid Grid.Row="1" Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ColPlan" Width="*" />
                                    <ColumnDefinition x:Name="ColSplitter" Width="6" />
                                    <ColumnDefinition x:Name="ColElevation" Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Plan View Viewport -->
                                <Border x:Name="BorderPlan" Grid.Column="0" Background="#14171C" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                                    <Canvas x:Name="CanvasPlan" ClipToBounds="True" SizeChanged="Canvas_SizeChanged" />
                                </Border>

                                <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#282C34" />

                                <!-- Front Elevation Viewport -->
                                <Border x:Name="BorderElevation" Grid.Column="2" Background="#14171C" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                                    <Canvas x:Name="CanvasElevation" ClipToBounds="True" SizeChanged="Canvas_SizeChanged" />
                                </Border>
                            </Grid>

                            <!-- Bottom Legend -->
                            <Border Grid.Row="2" Background="#1E2227" Padding="8,4" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,1,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Rectangle Width="9" Height="9" Fill="#61AFEF" Margin="0,0,3,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Solid" FontSize="9.5" Foreground="#ABB2BF" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <Rectangle Width="9" Height="9" Fill="#56B6C2" Margin="0,0,3,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Blend / Taper" FontSize="9.5" Foreground="#ABB2BF" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <Border Width="9" Height="9" BorderBrush="#E06C75" BorderThickness="1.2" Background="#25E06C75" Margin="0,0,3,0" VerticalAlignment="Center" />
                                    <TextBlock Text="✂️ Void Cut" FontSize="9.5" Foreground="#E06C75" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <Rectangle Width="9" Height="9" Fill="#98C379" Margin="0,0,3,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Nested" FontSize="9.5" Foreground="#ABB2BF" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <Ellipse Width="8" Height="8" Fill="#E5C07B" Stroke="#D19A66" StrokeThickness="1" Margin="0,0,3,0" VerticalAlignment="Center" />
                                    <TextBlock Text="MEP" FontSize="9.5" Foreground="#ABB2BF" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <Rectangle Width="8" Height="2" Fill="#E5C07B" Margin="0,0,3,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Dim" FontSize="9.5" Foreground="#ABB2BF" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <Rectangle Width="8" Height="2" Fill="#415A77" Margin="0,0,3,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Ref Plane" FontSize="9.5" Foreground="#ABB2BF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Tab 2: JSON Text Preview Editor -->
                    <TabItem Header="📝 JSON Specification">
                        <TextBox x:Name="TxtJsonPreview" AcceptsReturn="True" TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12" Foreground="#98C379" Background="#1E2227"
                                 BorderThickness="0"
                                 TextChanged="TxtJsonPreview_TextChanged" />
                    </TabItem>
                </TabControl>

                <!-- Row 4: Conversational AI Geometry Refiner Bar -->
                <Border Grid.Row="4" Background="#21252B" BorderBrush="#3E4451" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,6,0,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header & Refinement Action Chips -->
                        <Grid Grid.Row="0" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💬 Conversational AI Refiner" FontWeight="SemiBold" Foreground="#61AFEF" FontSize="11" />
                                <TextBlock Text=" (Sculpt &amp; modify geometry iteratively)" FontSize="10" Foreground="#5C6370" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BtnChipDeeper" Content="+25mm Bowl Depth" Click="BtnChip_Click" Tag="Increase the inner bowl void depth by 25mm to make the sink basin deeper" Background="#2C313A" Foreground="#ABB2BF" FontSize="10" Padding="5,2" Margin="0,0,4,0" Cursor="Hand" />
                                <Button x:Name="BtnChipOverflow" Content="+ Overflow Hole" Click="BtnChip_Click" Tag="Add a circular void overflow hole on the inner basin bowl wall" Background="#2C313A" Foreground="#ABB2BF" FontSize="10" Padding="5,2" Margin="0,0,4,0" Cursor="Hand" />
                                <Button x:Name="BtnChipWallHung" Content="Wall-Hung (No Pedestal)" Click="BtnChip_Click" Tag="Convert basin to wall-hung model by removing pedestal blend" Background="#2C313A" Foreground="#ABB2BF" FontSize="10" Padding="5,2" Margin="0,0,4,0" Cursor="Hand" />
                                <Button x:Name="BtnChipTapSpout" Content="Tall Spout" Click="BtnChip_Click" Tag="Make chrome mixer tap spout 35mm taller and extend further over bowl" Background="#2C313A" Foreground="#ABB2BF" FontSize="10" Padding="5,2" Margin="0,0,0,0" Cursor="Hand" />
                            </StackPanel>
                        </Grid>

                        <!-- Conversational Input Box + Refine Button -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtRefinePrompt" Height="30" FontSize="11" Padding="6,3" VerticalContentAlignment="Center"
                                     ToolTip="Enter refinement (e.g. 'make bowl 20mm deeper', 'change width to 750mm', 'add overflow hole', 'wall-hung'). Press Enter to refine."
                                     KeyDown="TxtRefinePrompt_KeyDown" Background="#1E2227" Foreground="#E5C07B" BorderBrush="#3E4451" />
                            <Button x:Name="BtnRefineGeometry" Grid.Column="1" Content="✨ Refine Geometry" 
                                    Margin="6,0,0,0" Padding="12,0" Height="30" FontSize="11" FontWeight="SemiBold"
                                    Background="#61AFEF" Foreground="#1E2227" Click="BtnRefineGeometry_Click" Cursor="Hand" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Row 5: Generate Button -->
                <Button x:Name="BtnGenerateRevitFamily" Grid.Row="5" Content="🚀 Generate &amp; Load Revit Family (.rfa)" 
                        Height="40" Margin="0,4,0,8" FontSize="14" FontWeight="Bold"
                        Click="BtnGenerateRevitFamily_Click" />

                <!-- Row 6: Logs Console -->
                <Border Grid.Row="6" Background="#1E2227" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="0" Margin="6,4,6,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Execution Logs:" FontSize="11" Foreground="#5C6370" VerticalAlignment="Center" />
                            <Button x:Name="BtnClearLogs" Grid.Column="1" Content="Clear" Background="Transparent" Foreground="#5C6370" FontSize="10" Padding="4,1" BorderThickness="0" Click="BtnClearLogs_Click" Cursor="Hand" />
                        </Grid>
                        
                        <TextBox x:Name="TxtLogs" Grid.Row="1" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                 Foreground="#ABB2BF" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" />
                        <ProgressBar x:Name="ProgBar" Grid.Row="2" Height="6" IsIndeterminate="True" Visibility="Collapsed" Foreground="#61AFEF" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <TextBlock Grid.Row="2" Text="Ready | ParametricFamilyForge for Revit 2024 / 2025 / 2026 | Configuration saved to %APPDATA%" FontSize="11" Foreground="#5C6370" Margin="0,8,0,0" />
    </Grid>
</Window>
